# _headers — Cloudflare Pages (indagor.ru)
# GitHub Pages эти заголовки отдавать не умеет; здесь появляется то, чего у сайта
# никогда не было: HSTS, X-Content-Type-Options, Referrer-Policy, Permissions-Policy.
# CSP сознательно не ставится: на 12 страницах инлайн-<style> и инлайн-<script>,
# строгая политика их сломает, а unsafe-inline в CSP бесполезен.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# HTML не кешируется надолго: правки должны доезжать сразу
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Служебные SEO/GEO-файлы: короткий кеш, чтобы правки доезжали за час
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/ai.txt
  Cache-Control: public, max-age=3600
/rss.xml
  Cache-Control: public, max-age=3600

# Статика: файлы меняются только с новым именем, поэтому кеш длинный
/assets/*
  Cache-Control: public, max-age=31536000, immutable
